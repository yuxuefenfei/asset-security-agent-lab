# Public browser configuration, injected at Vite build time. Never put secrets here.
# Copy to frontend/.env to change the browser values, then restart/rebuild.
VITE_API_BASE_URL=
VITE_API_TIMEOUT_MS=150000

# The current vite.config.ts reads LAB_DEV_API_URL from the process environment.
# Setting it only in frontend/.env does not configure the proxy.
# PowerShell, before pnpm dev:
# $env:LAB_DEV_API_URL = 'http://127.0.0.1:8080'
# Bash:
# LAB_DEV_API_URL=http://127.0.0.1:8080 pnpm dev
